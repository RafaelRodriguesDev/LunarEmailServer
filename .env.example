# Poste.io hostname. Use a real DNS name that points to your VPS.
POSTE_HOSTNAME=mail.seudominio.com.br

# Web interface ports on the VPS host.
POSTE_HTTP_PORT=3230
POSTE_HTTPS_PORT=3231

# Persistent Poste.io data path on the VPS.
POSTE_DATA_PATH=/opt/poste/data

# Container timezone.
TZ=America/Sao_Paulo
